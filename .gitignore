# GrowME fork: the internal AI handoff (AGENTS.md, its session history in
# docs/HISTORY.md, and the CLAUDE.md pointer) stays on the team drive. It names
# people, Slack threads and internal paths and is never published to this
# public repo. AGENTS.md was previously excluded only through .git/info/exclude.
AGENTS.md
CLAUDE.md
docs/HISTORY.md

# GrowME fork: NEVER commit OAuth client secrets / ADC files that may be
# dropped into the working tree during credential rotations. Real
# credentials live under ~/.config/growme-ads/.
client_secret*.json
adc*.json

# macOS AppleDouble files (external volumes)
._*

# Never commit a local env file dropped in during credential work
.env
.env.*
!.env.example
